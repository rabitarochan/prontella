{
  "name": "@rabitarochan/claude-deck",
  "version": "0.2.0",
  "type": "module",
  "description": "Deck for managing git repos, worktrees, and Claude Code agents in terminals",
  "license": "MIT",
  "bin": {
    "claude-deck": "bin/claude-deck.js"
  },
  "files": [
    "bin",
    "dist",
    "client/dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"tsx watch server/index.ts\" \"vite --port 8110\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "vite build && tsc -p server/tsconfig.build.json",
    "start": "node bin/claude-deck.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p server/tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@vscode/ripgrep": "^1.18.0",
    "editorconfig": "^3.0.2",
    "express": "^4.21.2",
    "iconv-lite": "^0.7.3",
    "jschardet": "^3.1.4",
    "node-pty": "^1.1.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^4.17.21",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "@vscode/codicons": "^0.0.44",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "dompurify": "^3.4.12",
    "emmet-monaco-es": "^5.7.0",
    "fuzzysort": "^3.1.0",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.30.0",
    "markdown-it": "^14.3.0",
    "markdown-it-task-lists": "^2.1.1",
    "monaco-editor": "^0.55.1",
    "react": "^18.3.1",
    "react-arborist": "^3.4.3",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^4.12.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.10",
    "zustand": "^5.0.10"
  }
}
