{
  "name": "prontella",
  "version": "0.2.0",
  "type": "module",
  "description": "Deck for managing git repos, worktrees, and Claude Code agents in terminals",
  "license": "MIT",
  "bin": {
    "prontella": "bin/prontella.js"
  },
  "files": [
    "bin",
    "dist",
    "client/dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"tsx watch server/index.ts\" \"vite --port 8110\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "vite build && tsc -p server/tsconfig.build.json",
    "start": "node bin/prontella.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p server/tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.260",
    "@vscode/ripgrep": "^1.18.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "editorconfig": "^3.0.2",
    "express": "^4.22.2",
    "iconv-lite": "^0.7.3",
    "jschardet": "^3.1.4",
    "node-pty": "^1.1.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@novnc/novnc": "^1.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^4.17.25",
    "@types/node": "^26.4.1",
    "@types/novnc__novnc": "^1.6.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vscode/codicons": "^0.0.45",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "dompurify": "^3.4.14",
    "emmet-monaco-es": "^5.7.0",
    "fuzzysort": "^4.0.2",
    "jsdom": "^30.0.1",
    "lucide-react": "^1.40.0",
    "markdown-it": "^15.0.1",
    "markdown-it-task-lists": "^2.1.1",
    "monaco-editor": "^0.56.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-arborist": "^3.16.0",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.12.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "zustand": "^5.0.15"
  }
}
